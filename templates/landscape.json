{
  "name": "风光摄影",
  "color_tone": "nature_cinematic",
  "text_style": "minimal",
  "aspect_ratio": "2.35:1",
  "music_mood": "ambient",
  "preferred_bpm": [50, 80],
  "structure": [
    {"phase": "opening", "duration": [5, 8], "content": ["wide_landscape", "drone_shot", "sunset"]},
    {"phase": "detail", "duration_ratio": 0.3, "content": ["closeup", "macro", "water", "flowers"]},
    {"phase": "motion", "duration_ratio": 0.2, "content": ["timelapse", "tracking", "flowing"]},
    {"phase": "atmosphere", "duration_ratio": 0.25, "content": ["sunset", "mist", "reflection", "silhouette"]},
    {"phase": "ending", "duration": [5, 8], "content": ["wide_landscape", "sunset", "stars"]}
  ],
  "transitions": {
    "default": "fade",
    "speed": 1.5,
    "cross_duration": 1.5
  },
  "color_presets": {
    "nature_cinematic": {
      "description": "电影感自然色调",
      "eq_brightness": 0.02,
      "eq_contrast": 1.08,
      "eq_saturation": 1.1,
      "eq_gamma": 1.05,
      "temperature": 6000,
      "vignette": 1.0,
      "letterbox": true
    },
    "golden_hour": {
      "description": "金色时刻暖调",
      "eq_brightness": 0.06,
      "eq_contrast": 1.05,
      "eq_saturation": 1.2,
      "temperature": 7500,
      "vignette": 0.8
    },
    "moody_forest": {
      "description": "暗调森林绿",
      "eq_brightness": -0.04,
      "eq_contrast": 1.12,
      "eq_saturation": 0.85,
      "eq_gamma": 0.95,
      "temperature": 5200,
      "vignette": 1.3
    },
    "teal_orange": {
      "description": "青橙色调",
      "eq_brightness": 0.01,
      "eq_contrast": 1.1,
      "eq_saturation": 1.05,
      "temperature": 5600,
      "vignette": 0.6
    }
  }
}
